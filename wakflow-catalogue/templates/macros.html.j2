{% macro logo(cls="") -%}
<span class="logo {{ cls }}"><img src="../assets/{{ "logo-mark-dark.png" if theme == "dark" else "logo-mark.png" }}" alt=""><b>Wakflow</b></span>
{%- endmacro %}

{% macro head(label, page_no) -%}
<header class="head">
  {{ logo() }}
  <span class="head-label">{{ label }}</span>
  <span class="head-page">{{ "%02d" % page_no }}</span>
</header>
{%- endmacro %}

{% macro foot() -%}
<footer class="foot">
  <span>Wakflow product catalogue 2026</span>
  <a href="https://wakflow.com">wakflow.com</a>
</footer>
{%- endmacro %}

{% macro star() -%}
<svg class="star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8l2.7 5.9 6.4.7-4.8 4.3 1.4 6.3L12 16.8 6.3 20l1.4-6.3-4.8-4.3 6.4-.7z" fill="currentColor"/></svg>
{%- endmacro %}

{% macro arrow() -%}
<svg class="btn-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endmacro %}

{% macro tick() -%}
<svg class="tick" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="currentColor"/><path d="M5.8 10.4l2.8 2.8 5.6-6.2" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endmacro %}
