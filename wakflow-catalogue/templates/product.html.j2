{% set fam = families[p.family] %}
{% set page_no = 4 + p.code|int %}
<section class="page product fam-{{ p.family }}{% if p.get("flagship") %} is-flagship{% endif %}" data-code="{{ p.code }}">
  <div class="bg-grid"></div>
  <div class="bg-glow"></div>
  <div class="page-inner">
    {{ m.rail("// " ~ p.code ~ " · " ~ fam.name, page_no) }}

    <div class="p-title">
      <div class="p-icon">{{ svg("icons/" ~ p.slug) }}</div>
      <div class="p-name">
        <p class="p-brand">Wakflow{% if p.get("flagship") %} <span class="flag">{{ m.star() }} Flagship</span>{% endif %}</p>
        <h2 class="grad">{{ p.name[8:] }}</h2>
      </div>
      <div class="p-count">
        <b>{{ p.feature_total }}</b>
        <span>{{ p.get("feature_label", "features") }}</span>
      </div>
    </div>

    <p class="p-headline">{{ p.headline }}</p>
    <p class="p-sub">{{ p.sub }}</p>
    {% if p.get("replaces") %}<p class="p-replaces"><span>Replaces</span>{{ p.replaces }}</p>{% endif %}

    <figure class="p-hero">{{ svg("hero/" ~ p.slug) }}</figure>

    <div class="p-split">
      <div class="p-pains">
        <h3 class="lbl lbl-red">// The problem</h3>
        {% for q in p.pains %}
        <blockquote>{{ q }}</blockquote>
        {% endfor %}
      </div>
      <div class="p-benefits">
        <h3 class="lbl">// What changes</h3>
        <ul>
          {% for b in p.benefits %}
          <li>{{ m.tick() }}<div><b>{{ b.t }}</b><span>{{ b.d }}</span></div></li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <div class="p-spec">
      <h3 class="lbl">// Inside <em>{{ p.feature_total }} {{ p.get("feature_label", "features") }} in {{ p.feature_groups|length }} groups · highlights</em></h3>
      <div class="spec-grid cols-{{ 4 if p.feature_groups|length > 6 or p.feature_groups|length == 4 else 3 }}">
        {% for g in p.feature_groups %}
        <div class="spec">
          <h4>{{ g.name }}</h4>
          <ul>{% for it in g["items"] %}<li>{{ it.show if it is mapping else it }}</li>{% endfor %}</ul>
        </div>
        {% endfor %}
      </div>
    </div>

    <div class="p-proof kind-{{ p.proof.kind }}">
      <h3 class="lbl lbl-green">// {{ p.proof.title }}</h3>
      {% if p.proof.kind == "numbers" %}
      <div class="stats n{{ p.proof["items"]|length }}">
        {% for s in p.proof["items"] %}
        <div class="stat"><b>{{ s.n }}</b><span>{{ s.l }}</span></div>
        {% endfor %}
      </div>
      {% else %}
      <ul class="dayone">
        {% for s in p.proof["items"] %}<li>{{ m.tick() }}<span>{{ s }}</span></li>{% endfor %}
      </ul>
      {% endif %}
    </div>

    <div class="p-foot">
      <div class="works">
        <h3 class="lbl">// Works with</h3>
        <div class="chips">
          {% for c in p.works_with %}{% set o = by_code[c] %}
          <span class="wchip fam-{{ o.family }}">{{ svg("icons/" ~ o.slug) }}<i>{{ c }}</i>{{ o.short }}</span>
          {% endfor %}
        </div>
      </div>
      <div class="cta">
        <p>{{ p.cta }}</p>
        <span class="btn">{{ p.button }}{{ m.arrow() }}</span>
        <span class="contact">wakflow.com · +91 96253 30270</span>
      </div>
    </div>
  </div>
</section>
